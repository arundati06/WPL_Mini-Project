# Copy this file to .env (same folder) and fill in your keys. Never commit .env.
# Kaggle: kaggle.com -> Settings -> API -> Create New Token (or use ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
# data.gov.in: register at https://data.gov.in -> My Account -> API key
DATAGOV_API_KEY=
# Optional: specific data.gov.in resource ids, comma-separated (otherwise the catalogue is searched)
DATAGOV_RESOURCES=
# --apply uses the MySQL login in server/.env (no settings needed here)
