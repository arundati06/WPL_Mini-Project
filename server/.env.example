# Copy to server/.env and fill in. Never commit .env.
# MongoDB: the local server that MongoDB Compass connects to. For MongoDB Atlas, paste its connection string here instead.
MONGODB_URI=mongodb://127.0.0.1:27017/scholarconnect
# Website port -> open http://localhost:3000
PORT=3000
# Any long random text; keeps login cookies secure. Change it.
SESSION_SECRET=change-this-to-a-long-random-string
