# Copy to server/.env and fill in. Never commit .env.
# MySQL / MariaDB (XAMPP default user is root with an empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scholarconnect
# Website port -> open http://localhost:3000
PORT=3000
# Any long random text; keeps login cookies secure. Change it.
SESSION_SECRET=change-this-to-a-long-random-string
